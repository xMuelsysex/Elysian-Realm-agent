ELYSIAN_AGENT_HOST=127.0.0.1
ELYSIAN_AGENT_PORT=4318

# Host state directory (realm.json config + realm.sqlite store).
# ELYSIAN_REALM_DATA=./realm-data

# Optional: enable POST /v1/realm/conversations by picking a model from the
# pi-ai catalog. Both variables must be set together.
# ELYSIAN_LLM_PROVIDER=anthropic
# ELYSIAN_LLM_MODEL=claude-sonnet-4-6
# Credentials use the provider's standard variable, e.g.:
# ANTHROPIC_API_KEY=...

# Admin web UI (http://<host>:<port>/admin) is enabled automatically on
# loopback binds. Binding to a non-loopback host requires a token:
# ELYSIAN_ADMIN_TOKEN=...
# Credentials saved via the admin page live here (0600):
# ELYSIAN_CREDENTIALS_PATH=~/.elysian-realm/credentials.json
