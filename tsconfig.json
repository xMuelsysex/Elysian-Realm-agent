{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@elysian/simulation-agent": [
        "src/index.ts"
      ],
      "@elysian/simulation-agent/service": [
        "src/service/index.ts"
      ],
      "@elysian/simulation-agent/llm/pi-ai": [
        "src/llm/piAiLlmPort.ts"
      ]
    },
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
