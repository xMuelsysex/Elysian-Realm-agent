  "cards": [
    {
      "dot": "cyan",
      "title": "双轨职责",
      "items": [
        "确定性 tick 走 realm-agent-step.v1，只在周期到点时触发",
        "对话走 realm-conversation.v1，单轮无状态、由宿主决定落库",
        "两轨共享同一记忆流与情感快照，各自保持单一事实来源"
      ]
    },
    {
      "dot": "rose",
      "title": "宿主权威",
      "items": [
        "服务只返回 proposal / memoryWrites / affinityDelta / mood 建议",
        "宿主决定是否应用，包内永不直接改世界状态",
        "档案按 profileId 隔离，切换后已发出的异步结果作废"
      ]
    },
    {
      "dot": "emerald",
      "title": "边界与依赖",
      "items": [
        "pi 代码只经 ./llm/pi-ai、./conversation/pi、./service/bootstrap 进入",
        "时间一律由调用方传入 at / now，核心不生成时间",
        "正史 Canon 只读注入，不写入角色经历记忆"
      ]
    }
